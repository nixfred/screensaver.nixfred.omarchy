#!/bin/bash
# Tear down every ORRERY window on every monitor.
pkill -f "^/usr/bin/python3 .*/bin/orrery$" 2>/dev/null
pkill -x orrery 2>/dev/null
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.class=="org.omarchy.screensaver") | .address' 2>/dev/null \
  | while read -r a; do
      hyprctl dispatch "hl.win.close({ address = \"$a\" })" >/dev/null 2>&1 \
        || hyprctl dispatch closewindow "address:$a" >/dev/null 2>&1
    done
exit 0
